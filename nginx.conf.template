server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # The dashboard calls the API with relative paths (see apiClient.ts),
    # resolved against window.location.origin — so in production this proxy
    # is what makes /api/* reach the api service at all, mirroring the
    # /api proxy the Vite dev server already does for local development.
    # API_UPSTREAM is filled in at container start (nginx's built-in
    # envsubst-on-templates hook) — docker-compose sets it to "api:3001",
    # a host with different service networking (e.g. Railway) sets it to
    # whatever that host calls the api service, e.g.
    # "api.railway.internal:3001".
    #
    # NGINX_RESOLVER matters just as much: nginx resolves a plain
    # proxy_pass hostname once at startup and hard-fails ("host not found
    # in upstream") if that name isn't resolvable yet at that moment —
    # a real problem for container DNS names, which can come up after
    # nginx does, or change on redeploy. Routing proxy_pass through a
    # variable forces per-request resolution against an explicit
    # resolver instead, so nginx starts fine either way and picks up
    # the target once it's actually resolvable. docker-compose sets
    # NGINX_RESOLVER to Docker's embedded DNS ("127.0.0.11 valid=1s");
    # Railway sets it to its private-networking resolver
    # ("[fd12::10] ipv6=on valid=1s").
    resolver ${NGINX_RESOLVER};

    location /api/ {
        set $upstream_api http://${API_UPSTREAM};
        proxy_pass $upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The Google OAuth connect flow (gmail-oauth.routes.ts) lives on the api
    # service but, unlike everything else it calls, isn't under /api/ — it's
    # a top-level browser navigation (Google redirects back to it directly),
    # and it needs req.user from the session cookie, which is only ever set
    # for this (the dashboard's) domain. Without this block that request
    # would either 404 against the SPA's index.html or, hit directly against
    # the api service's own Railway domain, arrive with no session cookie at
    # all and fail admin auth. Same proxy shape as /api/ above.
    location /auth/ {
        set $upstream_api http://${API_UPSTREAM};
        proxy_pass $upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
